{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gozar-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "af3468ea-12e4-497e-bd8f-c98741706f03","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0a139ddd8bd94c6bab38b8b342ca26eb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
